  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  },
  "name": "my-clinic-app",
  "private": true,
  "scripts": {
    "auth": "bunx auth@latest",
    "auth:generate": "bunx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "auth:migrate": "bun run auth:generate && bun run db generate && bun run db migrate",
    "auth:secret": "bunx auth@latest secret",
    "build": "vite build",
    "check": "biome check --write",
    "db": "drizzle-kit",
    "db:admin": "bun src/lib/auth/admin.ts",
    "db:check": "drizzle-kit check",
    "db:export": "drizzle-kit export",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:reset": "bun src/lib/db/reset.ts",
    "db:seed": "bun src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "deps": "bunx taze@latest -Ilw --maturity-period 3",
    "dev": "vite dev --port 3000",
    "format": "biome format",
    "fresh": "bun --bun --env-file=.env src/scripts/fresh.ts",
    "fresh:dry": "bun --bun --env-file=.env src/scripts/fresh.ts --dry-run",
    "fresh:from": "bun --bun --env-file=.env src/scripts/fresh.ts --from",
    "fresh:only": "bun --bun --env-file=.env src/scripts/fresh.ts --only",
    "fresh:paths": "bun --bun src/scripts/fresh.ts --print-paths",
    "generate-routes": "tsr generate",
    "intent": "bunx @tanstack/intent@latest",
    "lint": "biome lint",
    "prepare": "bun run generate-routes",
    "preview": "vite preview",
    "skills": "bunx skills@latest",
    "stage-seed": "bun --env-file=.env tsx ./src/lib/db/scripts/stage-seed.ts",
    "start": "node .output/server/index.mjs",
    "start:e2e": "node .output/server/index.mjs",
    "tanstack": "bunx @tanstack/router-cli generate",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty",
    "ui": "bunx shadcn@latest"
  },
  "type": "module"
