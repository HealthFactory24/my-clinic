{
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[less]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.wordWrap": "off"
  },
  "[scss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "biome.enabled": true,
  // ===== Biome (Linting & Formatting) =====
  // ============================================
  // BIOME INTEGRATION
  // ============================================
  "biome.lsp.bin": "node_modules/@biomejs/biome/bin/biome",
  "biome.requireConfiguration": true,
  // ===== Breadcrumbs =====
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "debug.internalConsoleOptions": "openOnSessionStart",
  "debug.onTaskErrors": "showErrors",
  // ===== Security =====
  // ===== Debugging =====
  "debug.openDebug": "openOnDebugBreak",
  // ===== Diff Editor =====
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "on",
  // ===== Breadcrumbs =====
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAllDangerous.oxc": "explicit",
    "source.format.oxc": "always",
    "source.removeUnusedImports": "explicit",
    "source.sort.json": "explicit"
  },
  "editor.codeLens": false,
  "editor.colorDecorators": false,
  "editor.cursorBlinking": "phase",
  "editor.defaultFormatter": "biomejs.biome",
  "editor.detectIndentation": false,
  "editor.dragAndDrop": true,
  "editor.find.autoFindInSelection": "multiline",
  "editor.folding": true,
  "editor.foldingStrategy": "auto",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnPaste": false,
  // ===== Editor Settings =====
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.glyphMargin": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "editor.hideCursorInOverviewRuler": false,
  "editor.hover.enabled": "on",
  "editor.hover.sticky": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.largeFileOptimizations": true,
  "editor.lineHeight": 1.6,
  "editor.lineNumbers": "on",
  "editor.linkedEditing": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "singleFile",
  "editor.overviewRulerBorder": false,
  "editor.parameterHints.enabled": true,
  // ===== Quick Suggestions =====
  "editor.quickSuggestions": {
    "comments": "off",
    "other": "on",
    "strings": "on"
  },
  "editor.quickSuggestionsDelay": 50,
  "editor.renderControlCharacters": true,
  "editor.renderFinalNewline": "on",
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [
    80,
    100,
    120
  ],
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "auto",
  "editor.selectionHighlight": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.smoothScrolling": true,
  // ===== Snippets =====
  "editor.snippetSuggestions": "bottom",
  "editor.suggest.snippetsPreventQuickSuggestions": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.wordBasedSuggestions": "currentDocument",
  "editor.wordWrap": "off",
  // ===== Emmet =====
  "emmet.includeLanguages": {
    "javascriptreact": "html",
    "typescriptreact": "html"
  },
  "emmet.showExpandedAbbreviation": "always",
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,
  "eslint.enable": false,
  "explorer.autoReveal": true,
  "explorer.compactFolders": false,
  // ===== Explorer =====
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, bun*, .yarnrc*, yarn*, .editorconfig, .gitattributes, oxfmt*, oxlint*, .oxfmt*, .oxlint*, commitlint.config*, bun.lock",
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*"
  },
  "explorer.incrementalNaming": "smart",
  "explorer.sortOrder": "default",
  "extensions.closeExtensionDetailsOnViewChange": true,
  // ===== Extensions =====
  "extensions.ignoreRecommendations": true,
  // ===== File Associations =====
  "files.associations": {
    ".env.*": "dotenv",
    "*.css": "tailwindcss",
    "*.json": "jsonc",
    "*.module.css": "tailwindcss",
    "*.module.scss": "tailwindcss",
    "*.scss": "tailwindcss"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.encoding": "utf8",
  // use LF line endings
  "files.eol": "\n",
  // ===== File Exclusions =====
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.output": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "files.readonlyInclude": {
    "**/.tanstack/**/*": true,
    "**/routeTree.gen.ts": true,
    "bun.lock": true,
    "docs": true
  },
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.tanstack/**/*": true,
    "**/routeTree.gen.ts": true,
    "bun.lock": true,
    "docs": true
  },
  // ===== Git =====
  "git.autofetch": true,
  "git.autorefresh": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.inputValidation": true,
  "git.inputValidationLength": 72,
  "git.inputValidationSubjectLength": 50,
  "git.mergeEditor": true,
  "js/ts.autoClosingTags.enabled": false,
  "js/ts.experimental.useTsgo": true,
  "js/ts.format.enabled": true,
  "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
  "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": false,
  "js/ts.implicitProjectConfig.experimentalDecorators": true,
  "js/ts.locale": "en",
  // ===== TypeScript/JavaScript =====
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.preferences.importModuleSpecifierEnding": "minimal",
  "js/ts.preferences.organizeImports": {
    "sortImportDeclarations": true,
    "sortImportMembers": true,
    "sortImportSpecifiers": true
  },
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.preferGoToSourceDefinition": true,
  // ===== Notifications =====
  "js/ts.server.showFailedResponses": "auto",
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.tsc.autoDetect": "on",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.maxMemory": 8192,
  "js/ts.tsserver.tracing.enabled": false,
  "js/ts.tsserver.watchOptions": {
    "fallbackPolling": "dynamicPriorityPolling",
    "watchDirectory": "useFsEvents",
    "watchFile": "useFsEvents"
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "json.format.enable": true,
  // ============================================
  // JSON
  // ============================================
  "json.schemas": [
    {
      "fileMatch": [
        "fhir/*.json"
      ],
      "url": "https://json.schemastore.org/fhir.schema.json"
    }
  ],
  "markdown.preview.breaks": true,
  "markdown.preview.linkify": true,
  "markdown.updateLinksOnFileMove.enabled": "always",
  "outline.problems.enabled": true,
  "output.smartScroll.enabled": true,
  "oxc.enable": false,
  "oxc.enable.oxfmt": false,
  "oxc.enable.oxlint": false,
  // enable oxlint + oxfmt
  // disable prettier, eslint, biome
  "prettier.enable": false,
  // ===== Problems =====
  "problems.autoReveal": true,
  "problems.defaultViewMode": "tree",
  "problems.showCurrentInStatus": true,
  "search.exclude": {
    "**/.cache": true,
    "**/.git": true,
    "**/.next": true,
    "**/.output": true,
    "**/.tanstack": true,
    "**/.tanstack/**/*": true,
    "**/.turbo": true,
    "**/.vinxi": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/routeTree.gen.ts": true,
    "bun.lock": true,
    "docs": true
  },
  "search.followSymlinks": false,
  "search.quickOpen.includeHistory": false,
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useIgnoreFiles": true,
  "tailwindcss-intellisense.trace.server": "off",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    "tw",
    "clsx"
  ],
  // ============================================
  // TAILWIND CSS
  // ============================================
  "tailwindCSS.classFunctions": [
    "clsx",
    "classnames",
    "cva",
    "cn",
    "tw",
    "tv",
    "tw\\.[a-z]+"
  ],
  "tailwindCSS.codeActions": true,
  "tailwindCSS.colorDecorators": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.classRegex": [
    [
      "cn\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ],
    [
      "cva\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ],
    [
      "clsx\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ]
  ],
  // ===== Tailwind Experimental =====
  "tailwindCSS.experimental.configFile": {
    "src/styles.css": "src/**/*.{ts,tsx,js,jsx}"
  },
  // ===== Tailwind Experimental =====
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.svn/**",
    "**/.output/**",
    "**/dist/**",
    "**/coverage/**"
  ],
  "tailwindCSS.hovers": true,
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascript",
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  // ===== Tailwind CSS IntelliSense =====
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.deprecatedAtRule": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.recommendedVariantOrder": "warning",
  "tailwindCSS.lint.suggestCanonicalClasses": "warning",
  "tailwindCSS.lint.usedBlocklistedClass": "warning",
  "tailwindCSS.rootFontSize": 16,
  "tailwindCSS.showPixelEquivalents": true,
  "tailwindCSS.suggestions": true,
  "tailwindCSS.validate": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  // ===== Telemetry =====
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.linux": "zsh",
  // ===== Terminal =====
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/bin/zsh"
    }
  },
  "terminal.integrated.rightClickBehavior": "selectWord",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.shellIntegration.environmentReporting": false,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on",
    "unknown": "off"
  },
  // ===== Testing =====
  "testing.automaticallyOpenPeekView": "never",
  // ===== Testing =====
  "testing.automaticallyOpenTestResults": "openOnTestStart",
  // ============================================
  // WINDOW & WORKBENCH
  // ============================================
  "window.closeWhenEmpty": false,
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}",
  "workbench.activityBar.location": "default",
  "workbench.colorTheme": "Visual Studio Light",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  // ===== Workbench =====
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.openPositioning": "right",
  "workbench.editor.pinnedTabSizing": "normal",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.wrapTabs": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": false,
  "workbench.productIconTheme": "Default",
  "workbench.settings.editor": "json",
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.settings.useSplitJSON": false,
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  // ============================================
  // YAML
  // ============================================
  "yaml.customTags": [
    "!env",
    "!env scalar"
  ],
  "zenMode.fullScreen": false,
  // ===== Zen Mode =====
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false
}
